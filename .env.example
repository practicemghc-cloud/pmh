# Sanity — copy this file to .env.local and fill in your project details.
#
# To get them:
#   1. npx sanity login
#   2. npx sanity init --project-plan free   (or reuse an existing project)
#   3. Copy the project ID it prints into NEXT_PUBLIC_SANITY_PROJECT_ID
#
# Until this is set the site still runs — it just uses the content built into
# src/lib/content/defaults.ts and /studio will not connect.

# --- Required. Read in the browser, so they must be present at BUILD time. ---
# NEXT_PUBLIC_* values are inlined into the bundle when `next build` runs, not
# read at boot. Adding them to a host after a build has no effect until you
# redeploy.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Optional ----------------------------------------------------------------

# Pins query behaviour. Defaults to 2024-10-01 in sanity/env.ts; only set this
# to move deliberately to a newer API date.
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only. Needed for the seeding script (npm run seed), which writes
# content. Create one at https://sanity.io/manage -> API -> Tokens, with Editor
# access. Never prefix this with NEXT_PUBLIC_ — that would ship a write token
# to every visitor's browser.
SANITY_WRITE_TOKEN=

# Server-only. Makes published changes appear within seconds instead of on the
# hour. Any long random string (`openssl rand -hex 32`); set the same value on
# the Sanity webhook that points at /api/revalidate.
SANITY_REVALIDATE_SECRET=
